# p2psession 服务器配置样例：复制为 .env 后按需修改。

# 宿主机映射端口（容器内固定监听 :60000）
P2PS_HOST_PORT=60000

# 连接票据 HMAC 密钥（base64url，32 字节）。
# 多实例部署必须配置且各实例一致；单实例可留空（启动时随机生成，
# 但重启后旧票据失效，客户端需重新 join）。
# 生成：openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
P2PS_TICKET_KEY=

# 会话默认存活时长与成员宽限期（离线后保留 MemberID 以便重连恢复）
P2PS_DEFAULT_TTL=30m
P2PS_MEMBER_GRACE=5m
# 连接票据有效期（覆盖「join 成功 → 建立两条 WS」的窗口）
P2PS_TICKET_TTL=10m

# 心跳与空闲断开
P2PS_HEARTBEAT=15s
P2PS_IDLE_TIMEOUT=45s

# 单实例会话数上限（0 = 不限）
P2PS_MAX_SESSIONS=0

# 帧大小上限（字节）
P2PS_MAX_CONTROL_FRAME=65536
P2PS_MAX_RELAY_FRAME=65536
P2PS_MAX_CANDIDATES=16

# 控制面消息限流（条/秒）与突发
P2PS_MSG_RATE_PER_SEC=25
P2PS_MSG_RATE_BURST=50

# 数据面中继带宽上限（字节/秒，0 = 不限）
P2PS_RELAY_BYTES_PER_SEC=524288
# 是否允许数据面中继（false 时只做信令与成员发现，不转发业务数据）
P2PS_RELAY_ENABLED=true

# 每 IP 的创建/加入频率上限（次/分钟）
P2PS_SESSION_RATE_PER_MIN=30
P2PS_JOIN_RATE_PER_MIN=120

# 浏览器 Origin 白名单（逗号分隔；* 放行全部；留空不校验）
P2PS_ALLOWED_ORIGINS=

# 位于 Cloudflare / 反向代理之后时信任 X-Forwarded-For / CF-Connecting-IP
P2PS_TRUST_PROXY_HEADERS=true

# 管理类接口（/v1/stats、/metrics）的 Bearer 令牌；留空则匿名可查
P2PS_ADMIN_TOKEN=

# 会话存储后端：memory（重启即清空，零依赖）| sqlite（持久化到单文件）
# 镜像默认 sqlite；本文件的默认值面向「直接 go run ./cmd/server」的场景，
# 因此保持 memory。用容器部署时镜像内的 ENV 会覆盖为 sqlite。
P2PS_STORAGE_BACKEND=memory
# SQLite 数据库文件路径（仅 sqlite 后端使用）。目录必须已存在且可写；
# 容器内是 /data（已声明为卷）。
P2PS_SQLITE_PATH=/data/p2psession.db

# 后台清扫间隔（过期会话 / 超宽限期离线成员）
P2PS_PRUNE_INTERVAL=60s

# 静态文件目录（本服务未内置前端；留空即可）
P2PS_STATIC_DIR=

# Named Tunnel（仅 profile=named 时使用）
# CLOUDFLARE_TUNNEL_TOKEN=
