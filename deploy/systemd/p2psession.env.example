# p2psession systemd 环境文件
#
# 安装位置：/etc/p2psession/p2psession.env
# 权限要求：0640，属主 root:p2psession
#   （里面是 HMAC 密钥与可能的管理员令牌，不能让同机其他用户读到）
#
#   sudo chown root:p2psession /etc/p2psession/p2psession.env
#   sudo chmod 0640 /etc/p2psession/p2psession.env
#
# `make install` 会自动生成此文件并填入随机 P2PS_TICKET_KEY；
# 已存在时**不会覆盖**（避免升级时把线上密钥抹掉）。
#
# 语法说明：systemd 的 EnvironmentFile 是**按行 KEY=VALUE**，
# 不要写 `export`，值不要加引号（引号会被当成值的一部分）。

# ---- 必填（安全相关）--------------------------------------------------------

# 连接票据的 HMAC 密钥（base64url，32 字节）。
#
# 作用：连接票据无状态自校验，因此该密钥决定了票据能否被本服务验证。
# 单实例：必须**固定**下来，否则每次重启都换新密钥，已签发的票据立即失效,
#         客户端会在重连时被拒（表现为「重启后必须重新 join」）。
# 多实例：所有实例必须完全一致。
#
# 生成：openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# 或：  head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
P2PS_TICKET_KEY=

# 管理类接口（/v1/stats、/metrics）的 Bearer 令牌。
#
# 留空 = 匿名可查。注意 /metrics 现在包含 build_info（版本/commit/go 版本），
# 公网部署建议设置，否则任何人都能读到你的构建信息。
# 生成方式同上。
P2PS_ADMIN_TOKEN=

# ---- 监听与网络 -------------------------------------------------------------

# 监听地址。
#   仅本机/反代：127.0.0.1:60000
#   直接对外：  :60000
# 注意：改用 80/443 等特权端口时，需同步在 unit 里放开 CAP_NET_BIND_SERVICE。
P2PS_LISTEN=:60000

# 位于反向代理 / Cloudflare 隧道之后时开启，否则限流的「每 IP」会退化成
# 全部请求都算作代理 IP，限流形同虚设。
P2PS_TRUST_PROXY_HEADERS=true

# 浏览器 Origin 白名单（逗号分隔）。留空不校验；对外提供服务时建议填写。
# P2PS_ALLOWED_ORIGINS=https://app.example.com

# ---- 存储 -------------------------------------------------------------------

# memory = 重启即清空（无状态）；sqlite = 持久化到单文件。
# unit 里已默认 sqlite，这里显式写出便于查看与修改。
P2PS_STORAGE_BACKEND=sqlite

# 数据库文件路径。目录由 systemd 的 StateDirectory=p2psession 提供
# （/var/lib/p2psession，属主 p2psession，权限 0750），无需手动创建。
P2PS_SQLITE_PATH=/var/lib/p2psession/p2psession.db

# ---- 会话生命周期 -----------------------------------------------------------

# 会话默认存活时长。
P2PS_DEFAULT_TTL=30m
# 成员掉线后保留其 MemberID 的宽限期（期间重连可恢复原身份与下标）。
P2PS_MEMBER_GRACE=5m
# 连接票据有效期（覆盖 join 成功 → 建立两条 WS 的窗口）。
P2PS_TICKET_TTL=10m

# 心跳要求间隔 / 连接读空闲断开阈值（后者必须 >= 前者）。
P2PS_HEARTBEAT=15s
P2PS_IDLE_TIMEOUT=45s

# 单实例会话数上限（0 = 不限）。自托管时可按内存设一个上限。
# P2PS_MAX_SESSIONS=1000

# ---- 限流与帧大小 -----------------------------------------------------------

# 每 IP 创建 / 加入会话的频率上限（次/分钟）。
P2PS_SESSION_RATE_PER_MIN=30
P2PS_JOIN_RATE_PER_MIN=120

# 控制面消息令牌桶（条/秒 + 突发）。
P2PS_MSG_RATE_PER_SEC=25
P2PS_MSG_RATE_BURST=50

# 帧大小上限（字节）。
P2PS_MAX_CONTROL_FRAME=65536
P2PS_MAX_RELAY_FRAME=65536
P2PS_MAX_CANDIDATES=16

# 数据面中继带宽上限（字节/秒，0 = 不限）。默认 512 KiB/s。
P2PS_RELAY_BYTES_PER_SEC=524288
# 是否允许数据面转发（false = 只做信令与成员发现）。
P2PS_RELAY_ENABLED=true

# ---- 维护 -------------------------------------------------------------------

# 过期会话 / 超宽限期离线成员的清扫间隔。
P2PS_PRUNE_INTERVAL=60s

# 静态文件目录（本服务未内置前端，通常留空）。
# P2PS_STATIC_DIR=
